# Vibony backend env. Copy to `.env` and fill in:
#
#   cp .env.example .env
#
# `.env` is gitignored — not committed. It is loaded automatically via python-dotenv
# on uvicorn startup (see vibony_backend/main.py).

# ---------- Rate limiting + request size ----------
# In-process rate limiter (per client IP). On by default; single-process only —
# a multi-worker deploy needs a shared store (Redis). Set to 0 to disable.
# VIBONY_RATELIMIT_ENABLED=1
# Trust the first X-Forwarded-For hop for the client IP. Leave OFF unless the app
# sits behind a reverse proxy that OVERWRITES the header — otherwise a client can
# spoof it and dodge the limiter. Default: use the peer address.
# VIBONY_TRUST_PROXY_HEADERS=1
# WebSocket Origin allowlist (guards against Cross-Site WebSocket Hijacking).
# Comma-separated allowed Origins; unset = no check (dev). SET in production to
# your dashboard origin(s) so a foreign page can't open the interviewer WS.
# VIBONY_ALLOWED_ORIGINS=https://app.example.com
# Max request body size in bytes (413 over the cap). Default 5 MB.
# VIBONY_MAX_BODY_BYTES=5242880

# ---------- LLM cost cap + WS/sandbox concurrency ----------
# Per-session cumulative LLM budget: caps a candidate / runaway tool loop burning
# paid calls. Durable across reconnect/restart; assistant + controller + compaction.
# Calls reserve quota before the provider request; token caps are soft. 0 = unlimited.
# VIBONY_SESSION_MAX_LLM_CALLS=1000
# VIBONY_SESSION_MAX_TOKENS=10000000
# Separate session-lifetime assessment quota (including regeneration/retries):
# VIBONY_ASSESSMENT_MAX_LLM_CALLS=20
# VIBONY_ASSESSMENT_MAX_TOKENS=200000
# Max buffered WS frames per subscriber before the slow consumer is closed and
# re-syncs via ?last_seq=. <= 0 = unbounded (not recommended). Default 1000.
# VIBONY_BROKER_QUEUE_MAXSIZE=1000
# Dedicated thread-pool size for blocking Docker SDK calls — isolates threads leaked
# by timed-out execs from asyncio's shared default executor. Default 32.
# VIBONY_SANDBOX_THREAD_POOL_SIZE=32

# ---------- Default model ----------
# litellm format. Examples:
#   deepseek/deepseek-chat
#   openai/gpt-4o-mini
#   anthropic/claude-haiku-4-5
#   openrouter/anthropic/claude-haiku-4.5
# For a custom endpoint use OPENAI_API_BASE (env, below), NOT the inline
# `model@endpoint` form — it is rejected for user-supplied models (SSRF guard).
VIBONY_DEFAULT_MODEL=

# Absolute ceiling on a single LLM call, seconds. A hung/very-slow provider call
# otherwise stalls the whole agent turn; on a timed async session the agent loop
# additionally caps each call at the candidate's remaining budget.
# VIBONY_LLM_CALL_TIMEOUT_SECONDS=300

# Model allowlist. Comma-separated. Unset → ONLY VIBONY_DEFAULT_MODEL is accepted for
# user-supplied models (session ai_config, /v1/chat). A model string containing `@` or
# `://` is always rejected (it would let litellm POST to an attacker endpoint — SSRF).
# Set this if employers may pick among several models:
# VIBONY_MODEL_ALLOWLIST=deepseek/deepseek-chat,openai/gpt-4o-mini

# Trap controller. A separate model that gates each assistant turn so the interview AI
# keeps its planted flaws until the candidate specifically names them (reject-and-retry
# on a disclosure). Unset → controller OFF (the agent loop is unchanged). Use a DIFFERENT
# model family than VIBONY_DEFAULT_MODEL (anti-circularity) and add it to
# VIBONY_MODEL_ALLOWLIST.
# VIBONY_CONTROLLER_MODEL=openai/gpt-4o-mini
#
# The controller's verdict is a small JSON classification, so its chain-of-thought is
# OFF by default (a reasoning model's <think> block can eat the token budget before the
# JSON → the gate silently fails open). The default is OpenRouter-shaped and a no-op for
# a non-reasoning model. Override only if needed: set to "" to send nothing (thinking
# back on), or a provider-specific JSON body for a non-OpenRouter controller.
# VIBONY_CONTROLLER_EXTRA_BODY={"reasoning": {"enabled": false}}

# Legacy/dev relay: the session-less POST /v1/chat path is an unauthenticated LLM relay,
# disabled by default. Leave UNSET in production. Set to 1 only for local experimentation:
# VIBONY_ALLOW_UNAUTH_CHAT=1

# ---------- Provider API keys (litellm reads them itself) ----------
# Fill in only the one your VIBONY_DEFAULT_MODEL needs. Leave the rest empty.

# DeepSeek
DEEPSEEK_API_KEY=

# OpenAI / OpenAI-compatible endpoints (including your own LLM proxy)
OPENAI_API_KEY=
# OPENAI_API_BASE=  # e.g. https://your-llm-proxy.example.com/v1

# Anthropic
ANTHROPIC_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# ---------- Database ----------
# asyncpg URL. For dev, docker-compose brings up Postgres on :5432:
#   docker compose up -d postgres   # from the monorepo root
VIBONY_DATABASE_URL=postgresql+asyncpg://vibony:vibony@localhost:5432/vibony

# ---------- Deployment posture ----------
# "development" (default) or "production". In production the backend fail-closes at
# startup: rejects default DB creds (vibony/vibony), requires TLS in
# VIBONY_DATABASE_URL (?ssl=verify-full), an https VIBONY_FRONTEND_URL, and a Secure cookie.
# VIBONY_ENV=production
# Enable the interactive API docs (/docs, /redoc, /openapi.json). Default OFF — in prod
# the schema is not exposed to the internet. For dev you may set it to 1.
# VIBONY_ENABLE_DOCS=1

# ---------- Auth ----------
# Authentication mode: password (default) or oidc (self-hosted).
VIBONY_AUTH_MODE=password

# Secret for signing session cookies + OIDC state + email-verify tokens. Minimum 32
# characters or the backend refuses to start. The value below is an INSECURE dev default
# so the stack boots out of the box — generate your own before any real or shared deploy:
#   python -c "import secrets; print(secrets.token_hex(32))"
VIBONY_SESSION_SECRET=dev-insecure-secret-change-me-before-deploy-0000

# Cookie domain. Empty = host-only (dev default). IMPORTANT: with VIBONY_COOKIE_SECURE=true
# the cookie gets the __Host- prefix and Domain is IGNORED (host-only is required) — this
# rules out cookie capture from a parent domain.
VIBONY_COOKIE_DOMAIN=

# false — for dev (http://localhost); true — for prod (https). When true the cookie
# becomes __Host-vibony_session (Secure + Path=/ + host-only). IMPORTANT: the OIDC
# flow-cookie inherits this flag too — if OIDC is served over plain HTTP, leave it false,
# otherwise the browser drops the flow-cookie and the callback returns invalid_state.
VIBONY_COOKIE_SECURE=false

# Host allowlist (comma-separated). If set, TrustedHostMiddleware rejects requests with a
# Host outside the list (defense against Host-header spoofing). Empty = no restriction
# (dev/test). In prod: app.example.com,www.example.com
VIBONY_ALLOWED_HOSTS=

# ---------- OIDC self-hosted (VIBONY_AUTH_MODE=oidc) ----------
VIBONY_OIDC_ISSUER=
VIBONY_OIDC_CLIENT_ID=
VIBONY_OIDC_CLIENT_SECRET=
# Optional. Comma-separated list of allowed email domains, e.g. corp.com,partner.com.
# If unset, any successfully authenticated IdP user is allowed in.
VIBONY_OIDC_ALLOWED_DOMAINS=
# Company name for the first OIDC login (if the company doesn't exist yet). Default "Vibony".
VIBONY_COMPANY_NAME=

# REQUIRED in OIDC mode: the absolute backend URL. The OIDC redirect_uri is built from it —
# NEVER from the Host header (defense against Host-spoofing / open-redirect). Without it the
# backend won't start in OIDC mode. Example: https://app.example.com
VIBONY_BASE_URL=

# Auto-linking a new OIDC identity to an existing account on matching email is allowed only
# if the IdP marked the email as verified (email_verified=true claim). If your IdP is fully
# trusted but doesn't send that claim, set to 1 to trust any email from the IdP. Default off
# (fail-closed).
VIBONY_OIDC_TRUST_EMAIL=

# Optional allowlist of id_token signature algorithms (comma-separated). Default: asymmetric
# RS*/ES*/PS*. `none` is always rejected.
VIBONY_OIDC_ID_TOKEN_ALGS=

# SSRF guard on the discovery/JWKS/token URL (requires https + a non-private IP). For
# dev/test with an http issuer, set to 1 to bypass the guard.
VIBONY_OIDC_ALLOW_INSECURE_ISSUER=

# ---------- Audit log retention ----------
# Hard-delete audit_log rows older than N days at startup (best-effort). Unset/0 = keep
# forever (default). Pair with subject-erasure DELETE /sessions/{code}.
# VIBONY_AUDIT_RETENTION_DAYS=365

# ---------- Frontend URL (for generating invite links) ----------
# Dashboard URL. Used when creating invites (accept_url) + email verification links. In
# dev, http://localhost:5173 (default). In prod, your domain.
VIBONY_FRONTEND_URL=http://localhost:5173

# ---------- Email (address verification) ----------
# Email backend: "console" (default — logs the email + link, dev/test) or "smtp" (real
# delivery via the SMTP settings below).
VIBONY_EMAIL_BACKEND=console
# Only needed when VIBONY_EMAIL_BACKEND=smtp:
VIBONY_SMTP_HOST=
VIBONY_SMTP_PORT=587
VIBONY_SMTP_USER=
VIBONY_SMTP_PASSWORD=
VIBONY_SMTP_FROM=

# ---------- Sandbox (web runtime) ----------
# "local" — temp-dir LocalToolset (no Docker; default for dev/test).
# "docker" — DockerSandboxProvider (requires Docker daemon + sandbox image).
VIBONY_SANDBOX_PROVIDER=local

# FAIL-CLOSED: local mode runs candidate bash UNSANDBOXED on the host. Production MUST use
# VIBONY_SANDBOX_PROVIDER=docker. To run local mode (dev/test) you must explicitly opt in —
# an AgentHost refuses to start otherwise.
VIBONY_ALLOW_LOCAL_SANDBOX=1

# Fallback image for sandbox containers (used when a task's spec.yaml omits runtime_image).
# Build: docker build -t vibony/sandbox-py:3.12 sandbox/images/py
VIBONY_SANDBOX_IMAGE=vibony/sandbox-py:3.12

# Optional resource limits per container.
# VIBONY_SANDBOX_CPU_LIMIT=1.0
# VIBONY_SANDBOX_MEM_LIMIT=512m
# VIBONY_SANDBOX_PIDS_LIMIT=256    # max processes/threads (fork-bomb guard)
# VIBONY_SANDBOX_NOFILE=1024       # max open file descriptors (nofile ulimit)

# Comma-separated hostnames the sandbox is allowed to reach.
# Default: deny all outbound. Example:
# VIBONY_SANDBOX_EGRESS_ALLOWLIST=pypi.org,files.pythonhosted.org,registry.npmjs.org

# Docker network mode for sandbox containers. "none" = fully isolated (default, prod).
# Set to "bridge" in dev to allow internet access for pip/poetry package installs.
# VIBONY_SANDBOX_NETWORK=none

# OCI runtime for sandbox containers. Unset = Docker default (runc). Set to "runsc" in
# production for gVisor kernel isolation (Linux host with gVisor installed). macOS dev /
# CI leave it unset.
# VIBONY_SANDBOX_RUNTIME=runsc

# Container hardening: cap_drop=ALL, no-new-privileges, private IPC and no-swap are ALWAYS
# on. Read-only rootfs is opt-in (needs tmpfs for /work + /tmp) — enable + verify on a real
# Linux Docker host before prod:
# VIBONY_SANDBOX_READONLY_ROOTFS=1
# VIBONY_SANDBOX_WORK_TMPFS_SIZE=256m
# VIBONY_SANDBOX_TMP_TMPFS_SIZE=64m

# Bash command timeout in the docker sandbox (ms). Default: 120 s. Raise when tasks need
# to install heavy packages (e.g. torch, tensorflow):
#   VIBONY_SANDBOX_BASH_TIMEOUT_MS=600000   # 10 min
# Also raise VIBONY_SANDBOX_MEM_LIMIT (torch needs 4+ GB during install):
#   VIBONY_SANDBOX_MEM_LIMIT=6g
# VIBONY_SANDBOX_BASH_TIMEOUT_MS=120000
